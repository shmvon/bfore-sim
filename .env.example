# Copy this file to .env for local testing (.env is never committed or put in the image).
# On the server, set these as environment variables of the container instead.

# Code to download the collected data on /download (digits or text)
DOWNLOAD_CODE=change-me

# Optional: where the data is stored (default: the folder data/ next to app.py;
# in the container /app/data, where the volume is mounted)
# DATA_DIR=data

# Optional: fixed session key (default: generated once into DATA_DIR/.secret_key)
# SECRET_KEY=

# Optional: port for 'python app.py' (default: 8500)
# PORT=8500
